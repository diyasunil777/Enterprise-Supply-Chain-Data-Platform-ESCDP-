    <connection>new88</connection>
    <sql>WITH geography_source AS (
    SELECT
        NULLIF(TRIM(o."Order City"::TEXT), '') AS city,
        NULLIF(TRIM(o."Order State"::TEXT), '') AS state,
        NULLIF(TRIM(o."Order Country"::TEXT), '') AS country,
        NULLIF(TRIM(s."Order Region"::TEXT), '') AS region,
        NULLIF(TRIM(s.market::TEXT), '') AS market,

        CASE
            WHEN TRIM(s.latitude::TEXT)
                 ~ '^-?[0-9]+(\.[0-9]+)?$'
            THEN TRIM(s.latitude::TEXT)::DOUBLE PRECISION
            ELSE NULL
        END AS latitude,

        CASE
            WHEN TRIM(s.longitude::TEXT)
                 ~ '^-?[0-9]+(\.[0-9]+)?$'
            THEN TRIM(s.longitude::TEXT)::DOUBLE PRECISION
            ELSE NULL
        END AS longitude

    FROM public."order_fulfillment_2000" o

    LEFT JOIN public."supply_chain_management_scm_2000" s
        ON TRIM(o."Order Id"::TEXT) =
           TRIM(s."Order Id"::TEXT)

    WHERE
        NULLIF(TRIM(o."Order City"::TEXT), '') IS NOT NULL
        OR NULLIF(TRIM(o."Order State"::TEXT), '') IS NOT NULL
        OR NULLIF(TRIM(o."Order Country"::TEXT), '') IS NOT NULL
),

distinct_geography AS (
    SELECT DISTINCT ON (
        city, state, country, region, market
    )
        city,
        state,
        country,
        region,
        market,
        latitude,
        longitude
    FROM geography_source
    ORDER BY
        city,
        state,
        country,
        region,
        market,
        latitude NULLS LAST,
        longitude NULLS LAST
)

SELECT
    g.city,
    g.state,
    g.country,
    g.region,
    g.market,
    g.latitude,
    g.longitude

FROM distinct_geography g

WHERE NOT EXISTS (
    SELECT 1
    FROM warehouse.dim_geography existing
    WHERE existing.city IS NOT DISTINCT FROM g.city
      AND existing.state IS NOT DISTINCT FROM g.state
      AND existing.country IS NOT DISTINCT FROM g.country
      AND existing.region IS NOT DISTINCT FROM g.region
      AND existing.market IS NOT DISTINCT FROM g.market
)

ORDER BY
    g.country,
    g.state,
    g.city;

</sql>
