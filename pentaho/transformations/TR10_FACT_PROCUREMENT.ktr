    <connection>new09</connection>
    <sql>SELECT DISTINCT ON (p.id)

    v.vendor_key,

    p.id::TEXT AS source_procurement_id,

    NULLIF(TRIM(p."Project Code"), '') AS project_code,

    NULLIF(TRIM(p."PO / SO #"), '') AS purchase_order_number,

    NULLIF(TRIM(p."Product Group"), '') AS product_group,

    NULLIF(TRIM(p."Sub Classification"), '') AS sub_classification,

    NULLIF(TRIM(p."Molecule/Test Type"), '') AS molecule_test_type,

    NULLIF(TRIM(p.dosage), '') AS dosage,

    NULLIF(TRIM(p."Dosage Form"), '') AS dosage_form,

    sd.date_key AS scheduled_date_key,

    dd.date_key AS delivered_date_key,

    p."Line Item Quantity"::NUMERIC AS line_item_quantity,

    p."Line Item Value"::NUMERIC AS line_item_value,

    p."Pack Price"::NUMERIC AS pack_price,

    p."Unit Price"::NUMERIC AS unit_price,

    p."Weight (Kilograms)"::NUMERIC AS weight_kg,

    CASE
        WHEN NULLIF(TRIM(p."Freight Cost (USD)"), '') IS NOT NULL
         AND TRIM(p."Freight Cost (USD)") ~ '^-?[0-9]+(\.[0-9]+)?$'
        THEN TRIM(p."Freight Cost (USD)")::NUMERIC
        ELSE NULL
    END AS freight_cost,

    p."Line Item Insurance (USD)"::NUMERIC AS insurance_cost

FROM public."procurement_2001" p

LEFT JOIN warehouse.dim_vendor v
    ON v.vendor_id = p."Managed By"
    OR v.vendor_name = p."Managed By"

LEFT JOIN warehouse.dim_date sd
    ON sd.full_date = CASE
        WHEN TRIM(p."Scheduled Delivery Date")
             ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}'
        THEN LEFT(TRIM(p."Scheduled Delivery Date"), 10)::DATE
        ELSE NULL
    END

LEFT JOIN warehouse.dim_date dd
    ON dd.full_date = CASE
        WHEN TRIM(p."Delivered to Client Date")
             ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}'
        THEN LEFT(TRIM(p."Delivered to Client Date"), 10)::DATE
        ELSE NULL
    END

WHERE p.id IS NOT NULL

AND NOT EXISTS (
    SELECT 1
    FROM warehouse.fact_procurement f
    WHERE f.source_procurement_id = p.id::TEXT
)

ORDER BY p.id;</sql>
