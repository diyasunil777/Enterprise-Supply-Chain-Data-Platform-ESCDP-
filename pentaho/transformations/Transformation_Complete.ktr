  <step>
    <name>ERP_Table_input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ERP_Test1</connection>
    <sql>SELECT DISTINCT
    "Order Id"                                         AS order_id,
    "Customer Id"                                      AS customer_id,
    INITCAP(TRIM("Customer Fname"))                    AS customer_fname,
    INITCAP(TRIM("Customer Lname"))                    AS customer_lname,
    LOWER(TRIM("Customer Email"))                      AS customer_email,
    INITCAP(TRIM("Customer Segment"))                  AS customer_segment,
    INITCAP(TRIM("Customer City"))                     AS customer_city,
    TRIM("Customer State")                             AS customer_state,
    TRIM("Customer Country")                           AS customer_country,
    TRIM("Customer Street")                            AS customer_street,
    REGEXP_REPLACE(TRIM("Customer Zipcode"), '\.0$', '') AS customer_zipcode,
    "Sales per customer"                               AS sales_per_customer,
    "Sales"                                            AS sales,
    "Order Item Profit Ratio"                          AS order_item_profit_ratio,
    "Order Profit Per Order"                           AS order_profit_per_order,
    "Benefit per order"                                AS benefit_per_order
FROM enterprise_resource_planning_erp
WHERE "Order Id" IS NOT NULL
  AND "Customer Id" IS NOT NULL;</sql>
