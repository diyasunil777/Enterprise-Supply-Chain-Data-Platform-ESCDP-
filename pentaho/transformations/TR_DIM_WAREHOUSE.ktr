    <connection>new3</connection>
    <sql>
SELECT DISTINCT ON (TRIM(distribution_center_id))
    TRIM(distribution_center_id) AS distribution_center_id,
    NULLIF(TRIM(distribution_center_name), '') AS warehouse_name,
    NULLIF(TRIM(warehouse_type), '') AS warehouse_type,
    NULLIF(TRIM(region), '') AS region,
    NULLIF(TRIM(city), '') AS city,
    NULLIF(TRIM(country), '') AS country,
    NULLIF(TRIM(manager_id), '') AS manager_id,
    NULLIF(TRIM(storage_type), '') AS storage_type,
    CASE
        WHEN NULLIF(TRIM(dock_doors), '') ~ '^[0-9]+$'
        THEN TRIM(dock_doors)::INTEGER
    END AS dock_doors,
    CASE
        WHEN NULLIF(TRIM(employees), '') ~ '^[0-9]+$'
        THEN TRIM(employees)::INTEGER
    END AS employees,
    NULLIF(TRIM(operating_shift), '') AS operating_shift,
    NULLIF(TRIM(status), '') AS status
FROM public."distribution_center_database_2000"
WHERE NULLIF(TRIM(distribution_center_id), '') IS NOT NULL
ORDER BY
    TRIM(distribution_center_id),
    TRIM(distribution_center_name);
</sql>
