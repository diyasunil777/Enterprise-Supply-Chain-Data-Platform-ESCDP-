    <connection>new3</connection>
    <sql>
SELECT DISTINCT ON (
    TRIM(i."Order Id"),
    TRIM(w."Order Item Id")
)
    d.order_key,
    p.product_key,
    TRIM(i."Order Id") AS source_order_id,
    NULLIF(TRIM(w."Order Item Id"), '') AS source_item_id,
    MD5(
        TRIM(i."Order Id") || '|' ||
        COALESCE(NULLIF(TRIM(w."Order Item Id"), ''), '') || '|' ||
        COALESCE(TRIM(i."Order Item Quantity"), '') || '|' ||
        COALESCE(TRIM(i."Order Item Total"), '')
    ) AS source_record_hash,
    NULLIF(TRIM(i."Order Item Quantity"), '')::NUMERIC AS quantity,
    NULLIF(TRIM(i."Product Price"), '')::NUMERIC AS product_price,
    NULLIF(TRIM(i."Order Item Product Price"), '')::NUMERIC
        AS item_product_price,
    NULLIF(TRIM(i."Order Item Total"), '')::NUMERIC AS item_total,
    NULLIF(TRIM(i."Order Item Discount"), '')::NUMERIC AS discount_amount,
    NULLIF(TRIM(i."Order Item Discount Rate"), '')::NUMERIC AS discount_rate
FROM public."inventory_management_2000" i
LEFT JOIN public."wms_excel_3_sheet1" w
    ON TRIM(i."Order Id") = TRIM(w."Order Id")
LEFT JOIN warehouse.dim_order d
    ON d.order_id = TRIM(i."Order Id")
LEFT JOIN warehouse.dim_product p
    ON p.product_id = TRIM(w."Product Card Id")
WHERE NULLIF(TRIM(i."Order Id"), '') IS NOT NULL
  AND d.order_key IS NOT NULL
  AND NOT EXISTS (
      SELECT 1
      FROM warehouse.fact_inventory f
      WHERE f.source_record_hash = MD5(
          TRIM(i."Order Id") || '|' ||
          COALESCE(NULLIF(TRIM(w."Order Item Id"), ''), '') || '|' ||
          COALESCE(TRIM(i."Order Item Quantity"), '') || '|' ||
          COALESCE(TRIM(i."Order Item Total"), '')
      )
  )
ORDER BY
    TRIM(i."Order Id"),
    TRIM(w."Order Item Id"),
    TRIM(w."Product Card Id");
</sql>
