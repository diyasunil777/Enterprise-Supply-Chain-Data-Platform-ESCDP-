      <schema_name/>
    </partitioning>
    <connection>new3</connection>
    <sql>SELECT DISTINCT ON (TRIM(t.order_id))
    d.order_key,
    sm.shipping_mode_key,
    sd.date_key AS shipping_date_key,
    TRIM(t.order_id) AS source_order_id,

    CASE
        WHEN LOWER(TRIM(l.late_delivery_risk::TEXT))
             IN ('1', 'true', 'yes') THEN 1
        WHEN LOWER(TRIM(l.late_delivery_risk::TEXT))
             IN ('0', 'false', 'no') THEN 0
        ELSE NULL
    END AS late_delivery_risk,

    CASE
        WHEN NULLIF(TRIM(t.days_for_shipping_real::TEXT), '')
             ~ '^-?[0-9]+(\.[0-9]+)?$'
        THEN TRIM(t.days_for_shipping_real::TEXT)::NUMERIC
        ELSE NULL
    END AS actual_shipping_days,

    CASE
        WHEN NULLIF(TRIM(t.days_for_shipment_scheduled::TEXT), '')
             ~ '^-?[0-9]+(\.[0-9]+)?$'
        THEN TRIM(t.days_for_shipment_scheduled::TEXT)::NUMERIC
        ELSE NULL
    END AS scheduled_shipping_days,

    NULLIF(TRIM(l.delivery_status::TEXT), '') AS delivery_status

FROM public."transportation_management_tms_2000" t

LEFT JOIN public."logistics_tracking_2000" l
    ON TRIM(t.order_id) = TRIM(l.order_id)

LEFT JOIN warehouse.dim_order d
    ON d.order_id = TRIM(t.order_id)

LEFT JOIN warehouse.dim_shipping_mode sm
    ON UPPER(TRIM(sm.shipping_mode)) = UPPER(TRIM(t.shipping_mode))

LEFT JOIN warehouse.dim_date sd
    ON sd.full_date = CASE
        WHEN TRIM(t.shipping_date_dateorders::TEXT)
             ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}'
        THEN LEFT(TRIM(t.shipping_date_dateorders::TEXT), 10)::DATE
        ELSE NULL
    END

WHERE NULLIF(TRIM(t.order_id), '') IS NOT NULL
  AND d.order_key IS NOT NULL
  AND NOT EXISTS (
      SELECT 1
      FROM warehouse.fact_shipping f
      WHERE f.source_order_id = TRIM(t.order_id)
  )

ORDER BY
    TRIM(t.order_id),
    t.shipping_date_dateorders;
</sql>
